// Interaction signals contain no text and never count passive mouse movement.
let lastWorkSignal=0;
for(const name of ['keydown','pointerdown','wheel','input'])window.addEventListener(name,(event)=>{setTimeout(()=>{if(event instanceof KeyboardEvent&&['Control','Shift','Alt','Meta'].includes(event.key))return;if(document.documentElement.dataset.commandPalette==='open'||(event.target as Element)?.closest?.('dialog[data-command-palette]'))return;const now=Date.now();if(now-lastWorkSignal>500){lastWorkSignal=now;ipcRenderer.send('writing-interaction');}});},{capture:true,passive:true});
